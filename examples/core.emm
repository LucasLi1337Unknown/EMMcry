// Lexical closures, recursion, lists, records, and recoverable errors.
??... factorial(n)
{
    ?? n <= 1 { !... 1 }
    !... n * ...?? factorial(n - 1)
}
??... makeCounter()
{
    ... count = 0
    ??... next()
    {
        ! count = count + 1
        !... count
    }
    !... next
}
... counter = ...?? makeCounter()
...! ...?? counter()
...! ...?? counter()
...! ...?? factorial(6)
... hand = [{rank: 14, suit: "S"}, {rank: 13, suit: "H"}]
..... card : hand
{
    ...! card.rank
}
?:
{
    ...! hand[99]
}
?!! error
{
    ...! "Caught: " + error
}

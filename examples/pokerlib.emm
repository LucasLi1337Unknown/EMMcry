// Real five-card evaluator. Return [category, tiebreakers...]. Higher wins.
// Categories: 0 high card ... 8 straight flush. Suit never breaks a tie.
??... evaluate(hand)
{
    ...?? $24(...?? $1(hand) == 5)
    ... ranks = []
    ... flush = ++
    ... suit = hand[0].suit
    ..... card : hand
    {
        ...?? $24(card.rank >= 2 && card.rank <= 14)
        ...?? $7(ranks, card.rank)
        ?? card.suit != suit { ! flush = -- }
    }
    ! ranks = ...?? $10(ranks)
    ... unique = []
    ... counts = []
    ..... rank : ranks
    {
        ... n = ...?? $1(unique)
        ?? n == 0 || unique[n - 1] != rank
        {
            ...?? $7(unique, rank)
            ...?? $7(counts, 1)
        }
        ???? { ! counts[n - 1] = counts[n - 1] + 1 }
    }
    ... straight = 0
    ?? ...?? $1(unique) == 5
    {
        ?? unique[4] - unique[0] == 4 { ! straight = unique[4] }
        ??? unique[0] == 2 && unique[1] == 3 && unique[2] == 4 && unique[3] == 5 && unique[4] == 14
        { ! straight = 5 }
    }
    ... groups = []
    ..... size : [4, 3, 2, 1]
    {
        ... i = ...?? $1(unique) - 1
        ...... i >= 0
        {
            ?? counts[i] == size { ...?? $7(groups, unique[i]) }
            ! i = i - 1
        }
    }
    ... largest = 1
    ... pairs = 0
    ..... size : counts
    {
        ! largest = ...?? $3(largest, size)
        ?? size == 2 { ! pairs = pairs + 1 }
    }
    ?? flush && straight > 0 { !... [8, straight] }
    ?? largest == 4 { !... [7] + groups }
    ?? largest == 3 && pairs == 1 { !... [6] + groups }
    ?? flush { !... [5] + groups }
    ?? straight > 0 { !... [4, straight] }
    ?? largest == 3 { !... [3] + groups }
    ?? pairs == 2 { !... [2] + groups }
    ?? pairs == 1 { !... [1] + groups }
    !... [0] + groups
}
??... compare(a, b)
{
    ... i = 0
    ...... i < ...?? $1(a)
    {
        ?? a[i] > b[i] { !... 1 }
        ?? a[i] < b[i] { !... -1 }
        ! i = i + 1
    }
    !... 0
}
